#include <iostream>
#include <string>
#include <fstream>
#include <vector>
#include <cmath>
#include <cstring>

// ===== Test configuration =====
// These must match gentests.py
constexpr int N_SEQS = 16;
constexpr int CHUNK_SIZE = 64;
constexpr int D_HEAD = 128;
constexpr int N_HEADS = 4;
constexpr int N_CHUNKS = 2;

// Block size must match kernel (1 warp = 32 threads)
constexpr int BLOCK_LAUNCH_SIZE = 32;

// ===== Debug configuration =====
#define HARNESS_DEBUG 1       // Print debug info
#define HARNESS_VERBOSE 0     // Print even more details

#define CudaCheckError()    __cudaCheckError( __FILE__, __LINE__ )
inline void __cudaCheckError( const char *file, const int line ) {
    cudaError err = cudaGetLastError();
    if ( cudaSuccess != err ) {
        fprintf( stderr, "cudaCheckError() failed at %s:%i : %s\n",
                 file, line, cudaGetErrorString( err ) );
        exit( -1 );
    }
    err = cudaDeviceSynchronize();
    if( cudaSuccess != err ) {
        fprintf( stderr, "cudaCheckError() with sync failed at %s:%i : %s\n",
                 file, line, cudaGetErrorString( err ) );
        exit( -1 );
    }
}

template<typename T>
void read_array(std::ifstream& infile, T* arr, int count, const char* name) {
#if HARNESS_VERBOSE
    std::cout << "  Loading " << name << " (" << count << " elements)..." << std::endl;
#endif
    for(int i = 0; i < count; i++) {
        float val;
        infile >> val;
        arr[i] = static_cast<T>(val);
    }
}

// Helper to convert float array to bf16
void float_to_bf16(const float* src, bf16* dst, int count) {
    for (int i = 0; i < count; i++) {
        dst[i] = __float2bfloat16(src[i]);
    }
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "Usage: " << argv[0] << " <test_file.txt>" << std::endl;
        return 1;
    }

    std::cout << "=== Chunked Attention TK Test Harness ===" << std::endl;
    std::cout << "Configuration:" << std::endl;
    std::cout << "  N_SEQS=" << N_SEQS << ", CHUNK_SIZE=" << CHUNK_SIZE << std::endl;
    std::cout << "  D_HEAD=" << D_HEAD << ", N_HEADS=" << N_HEADS << std::endl;
    std::cout << "  N_CHUNKS=" << N_CHUNKS << ", BLOCK_SIZE=" << BLOCK_LAUNCH_SIZE << std::endl;

    // ===== STEP 1: Allocate host memory =====
    constexpr int Q_SIZE = N_SEQS * N_HEADS * D_HEAD;
    constexpr int KV_CHUNK_SIZE = N_HEADS * CHUNK_SIZE * D_HEAD;
    constexpr int OUT_CHUNK_SIZE = N_HEADS * N_SEQS * D_HEAD;
    constexpr int MAX_SUM_CHUNK_SIZE = N_HEADS * N_SEQS;

    std::cout << "\nSizes:" << std::endl;
    std::cout << "  Q: " << Q_SIZE << " elements" << std::endl;
    std::cout << "  KV per chunk: " << KV_CHUNK_SIZE << " elements" << std::endl;
    std::cout << "  Output per chunk: " << OUT_CHUNK_SIZE << " elements" << std::endl;

    // Host arrays (float for reading from file)
    float *h_q_float = new float[Q_SIZE];
    float *h_k_float[N_CHUNKS];
    float *h_v_float[N_CHUNKS];
    float *h_out_ref[N_CHUNKS];
    float *h_maxs_ref[N_CHUNKS];
    float *h_sums_ref[N_CHUNKS];

    for(int i = 0; i < N_CHUNKS; i++) {
        h_k_float[i] = new float[KV_CHUNK_SIZE];
        h_v_float[i] = new float[KV_CHUNK_SIZE];
        h_out_ref[i] = new float[OUT_CHUNK_SIZE];
        h_maxs_ref[i] = new float[MAX_SUM_CHUNK_SIZE];
        h_sums_ref[i] = new float[MAX_SUM_CHUNK_SIZE];
    }

    // ===== STEP 2: Load test data from file =====
    std::cout << "\nLoading test data from: " << argv[1] << std::endl;
    std::ifstream infile(argv[1]);
    if (!infile.is_open()) {
        std::cerr << "Failed to open " << argv[1] << std::endl;
        return 1;
    }

    read_array(infile, h_q_float, Q_SIZE, "Q");
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "K chunk %d", i);
        read_array(infile, h_k_float[i], KV_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "V chunk %d", i);
        read_array(infile, h_v_float[i], KV_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Output ref chunk %d", i);
        read_array(infile, h_out_ref[i], OUT_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Maxs ref chunk %d", i);
        read_array(infile, h_maxs_ref[i], MAX_SUM_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Sums ref chunk %d", i);
        read_array(infile, h_sums_ref[i], MAX_SUM_CHUNK_SIZE, name);
    }
    infile.close();
    std::cout << "Test data loaded successfully!" << std::endl;

#if HARNESS_DEBUG
    // Print some reference values for debugging
    std::cout << "\nReference values (first few):" << std::endl;
    std::cout << "  Q[0:3] = " << h_q_float[0] << ", " << h_q_float[1] << ", " << h_q_float[2] << std::endl;
    std::cout << "  K[0][0:3] = " << h_k_float[0][0] << ", " << h_k_float[0][1] << ", " << h_k_float[0][2] << std::endl;
    std::cout << "  V[0][0:3] = " << h_v_float[0][0] << ", " << h_v_float[0][1] << ", " << h_v_float[0][2] << std::endl;
    std::cout << "  Out_ref[0][0:3] = " << h_out_ref[0][0] << ", " << h_out_ref[0][1] << ", " << h_out_ref[0][2] << std::endl;
    std::cout << "  Maxs_ref[0][0:3] = " << h_maxs_ref[0][0] << ", " << h_maxs_ref[0][1] << ", " << h_maxs_ref[0][2] << std::endl;
    std::cout << "  Sums_ref[0][0:3] = " << h_sums_ref[0][0] << ", " << h_sums_ref[0][1] << ", " << h_sums_ref[0][2] << std::endl;
#endif

    // ===== STEP 3: Allocate device memory =====
    std::cout << "\nAllocating device memory..." << std::endl;

    // IMPORTANT: Q, K, V are bf16 on device!
    bf16 *d_q;
    bf16 *d_k[N_CHUNKS];
    bf16 *d_v[N_CHUNKS];
    float *d_attns;
    float *d_maxs;
    float *d_sums;
    void **d_keys_ptrs;
    void **d_values_ptrs;
    int *d_offsets, *d_begins, *d_ends;

    // Allocate with correct bf16 sizes
    cudaMalloc(&d_q, Q_SIZE * sizeof(bf16));
    for(int i = 0; i < N_CHUNKS; i++) {
        cudaMalloc(&d_k[i], KV_CHUNK_SIZE * sizeof(bf16));
        cudaMalloc(&d_v[i], KV_CHUNK_SIZE * sizeof(bf16));
    }

    // Output buffers (float) - accumulate all chunks
    const int total_output_size = N_CHUNKS * OUT_CHUNK_SIZE;
    const int total_maxsum_size = N_CHUNKS * MAX_SUM_CHUNK_SIZE;
    cudaMalloc(&d_attns, total_output_size * sizeof(float));
    cudaMalloc(&d_maxs, total_maxsum_size * sizeof(float));
    cudaMalloc(&d_sums, total_maxsum_size * sizeof(float));

    // Initialize outputs to zero
    cudaMemset(d_attns, 0, total_output_size * sizeof(float));
    cudaMemset(d_maxs, 0, total_maxsum_size * sizeof(float));
    cudaMemset(d_sums, 0, total_maxsum_size * sizeof(float));

    // ===== STEP 4: Convert float to bf16 and copy to device =====
    std::cout << "Converting float to bf16 and copying to device..." << std::endl;

    // Convert Q
    bf16 *h_q_bf16 = new bf16[Q_SIZE];
    float_to_bf16(h_q_float, h_q_bf16, Q_SIZE);
    cudaMemcpy(d_q, h_q_bf16, Q_SIZE * sizeof(bf16), cudaMemcpyHostToDevice);
    delete[] h_q_bf16;

    // Convert and copy K, V for each chunk
    for(int i = 0; i < N_CHUNKS; i++) {
        bf16 *h_k_bf16 = new bf16[KV_CHUNK_SIZE];
        bf16 *h_v_bf16 = new bf16[KV_CHUNK_SIZE];

        float_to_bf16(h_k_float[i], h_k_bf16, KV_CHUNK_SIZE);
        float_to_bf16(h_v_float[i], h_v_bf16, KV_CHUNK_SIZE);

        cudaMemcpy(d_k[i], h_k_bf16, KV_CHUNK_SIZE * sizeof(bf16), cudaMemcpyHostToDevice);
        cudaMemcpy(d_v[i], h_v_bf16, KV_CHUNK_SIZE * sizeof(bf16), cudaMemcpyHostToDevice);

        delete[] h_k_bf16;
        delete[] h_v_bf16;
    }
    CudaCheckError();

    // ===== STEP 5: Setup K/V pointer arrays =====
    void *h_keys_ptrs[N_CHUNKS];
    void *h_values_ptrs[N_CHUNKS];
    for(int i = 0; i < N_CHUNKS; i++) {
        h_keys_ptrs[i] = d_k[i];
        h_values_ptrs[i] = d_v[i];
    }
    cudaMalloc(&d_keys_ptrs, N_CHUNKS * sizeof(void*));
    cudaMalloc(&d_values_ptrs, N_CHUNKS * sizeof(void*));
    cudaMemcpy(d_keys_ptrs, h_keys_ptrs, N_CHUNKS * sizeof(void*), cudaMemcpyHostToDevice);
    cudaMemcpy(d_values_ptrs, h_values_ptrs, N_CHUNKS * sizeof(void*), cudaMemcpyHostToDevice);

    // ===== STEP 6: Setup chunk metadata =====
    int h_begins[N_CHUNKS];
    int h_ends[N_CHUNKS];
    int h_offsets[N_CHUNKS];

    for(int i = 0; i < N_CHUNKS; i++) {
        h_begins[i] = 0;            // All chunks process seqs [0, N_SEQS)
        h_ends[i] = N_SEQS;
        h_offsets[i] = i * N_SEQS;  // Sequential offsets for output
    }

    cudaMalloc(&d_begins, N_CHUNKS * sizeof(int));
    cudaMalloc(&d_ends, N_CHUNKS * sizeof(int));
    cudaMalloc(&d_offsets, N_CHUNKS * sizeof(int));
    cudaMemcpy(d_begins, h_begins, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);
    cudaMemcpy(d_ends, h_ends, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);
    cudaMemcpy(d_offsets, h_offsets, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);
    CudaCheckError();

#if HARNESS_DEBUG
    std::cout << "\nChunk metadata:" << std::endl;
    for(int i = 0; i < N_CHUNKS; i++) {
        std::cout << "  Chunk " << i << ": begins=" << h_begins[i]
                  << ", ends=" << h_ends[i] << ", offset=" << h_offsets[i] << std::endl;
    }
#endif

    // ===== STEP 7: Setup kernel globals =====
    using globals_t = attn_chunk_first_globals<N_SEQS, D_HEAD>;

    // Construct gl objects with correct dimensions
    // Q is stored as [N_SEQS, N_HEADS, D_HEAD], we view it as [1, 1, N_SEQS, N_HEADS*D_HEAD]
    // This gives row_stride = N_HEADS * D_HEAD, and we load D_HEAD cols starting at head_idx * D_HEAD
    auto gQ = gl<bf16, 1, 1, N_SEQS, -1, st<bf16, N_SEQS, D_HEAD>>(
        d_q, nullptr, nullptr, nullptr, N_HEADS * D_HEAD);

    // gAttns: [1, 1, total_seqs * n_heads, d_head] treated as 1D array
    auto gAttns = gl<float, -1, -1, -1, -1>(
        d_attns, 1, 1, N_CHUNKS * N_HEADS * N_SEQS, D_HEAD);

    // gMaxs/gSums: [1, 1, 1, total_maxsum_size] treated as 1D array
    auto gMaxs = gl<float, -1, -1, -1, -1>(
        d_maxs, 1, 1, 1, total_maxsum_size);

    auto gSums = gl<float, -1, -1, -1, -1>(
        d_sums, 1, 1, 1, total_maxsum_size);

    auto gOffsets = gl<int, -1, -1, -1, -1>(
        d_offsets, 1, 1, 1, N_CHUNKS);

    auto gBegins = gl<int, -1, -1, -1, -1>(
        d_begins, 1, 1, 1, N_CHUNKS);

    auto gEnds = gl<int, -1, -1, -1, -1>(
        d_ends, 1, 1, 1, N_CHUNKS);

    globals_t g{
        .gAttns = gAttns,
        .gMaxs = gMaxs,
        .gSums = gSums,
        .gOffsets = gOffsets,
        .gBegins = gBegins,
        .gEnds = gEnds,
        .gQ = gQ,
        .gKeys = d_keys_ptrs,
        .gValues = d_values_ptrs,
        .dim_scale = 1.0f / sqrtf(static_cast<float>(D_HEAD)),
        .n_heads = N_HEADS
    };

    // ===== STEP 8: Calculate shared memory size =====
    // Shared memory layout (must match kernel allocations):
    // - Qs: st<bf16, N_SEQS, D_HEAD>
    // - Ks: st<bf16, CHUNK_SIZE, D_HEAD>
    // - Vs: st<bf16, CHUNK_SIZE, D_HEAD>
    // - out_smem: st<float, N_SEQS, D_HEAD>

    size_t Qs_size = sizeof(st<bf16, N_SEQS, D_HEAD>);
    size_t Ks_size = sizeof(st<bf16, CHUNK_SIZE, D_HEAD>);
    size_t Vs_size = sizeof(st<bf16, CHUNK_SIZE, D_HEAD>);
    size_t out_smem_size = sizeof(st<float, N_SEQS, D_HEAD>);

    size_t shared_mem_size = Qs_size + Ks_size + Vs_size + out_smem_size;
    // Add some padding for alignment
    shared_mem_size = ((shared_mem_size + 4095) / 4096) * 4096;

    std::cout << "\nShared memory breakdown:" << std::endl;
    std::cout << "  Qs: " << Qs_size << " bytes" << std::endl;
    std::cout << "  Ks: " << Ks_size << " bytes" << std::endl;
    std::cout << "  Vs: " << Vs_size << " bytes" << std::endl;
    std::cout << "  out_smem: " << out_smem_size << " bytes" << std::endl;
    std::cout << "  Total (padded): " << shared_mem_size << " bytes" << std::endl;

    // ===== STEP 9: Set kernel attributes =====
    cudaFuncSetAttribute(
        attn_chunk_first_tk<N_SEQS, CHUNK_SIZE, D_HEAD>,
        cudaFuncAttributeMaxDynamicSharedMemorySize,
        shared_mem_size
    );
    CudaCheckError();

    // ===== STEP 10: Launch kernel =====
    dim3 grid(N_HEADS, N_CHUNKS);
    dim3 block(BLOCK_LAUNCH_SIZE);

    std::cout << "\n=== Launching kernel ===" << std::endl;
    std::cout << "  Grid: (" << grid.x << ", " << grid.y << ")" << std::endl;
    std::cout << "  Block: " << block.x << std::endl;
    std::cout << "  Shared memory: " << shared_mem_size << " bytes" << std::endl;
    std::cout << "  dim_scale: " << g.dim_scale << std::endl;

    cudaDeviceSynchronize();
    const auto start = std::chrono::high_resolution_clock::now();

    attn_chunk_first_tk<N_SEQS, CHUNK_SIZE, D_HEAD><<<grid, block, shared_mem_size>>>(g);

    cudaDeviceSynchronize();
    const auto finish = std::chrono::high_resolution_clock::now();
    CudaCheckError();

    std::cout << "\n=== Kernel completed ===" << std::endl;
    std::cout << "Execution time: " << std::chrono::duration_cast<std::chrono::microseconds>(finish - start).count()
              << " us" << std::endl;

    // ===== STEP 11: Copy results back =====
    float *h_attns = new float[total_output_size];
    float *h_maxs = new float[total_maxsum_size];
    float *h_sums = new float[total_maxsum_size];

    cudaMemcpy(h_attns, d_attns, total_output_size * sizeof(float), cudaMemcpyDeviceToHost);
    cudaMemcpy(h_maxs, d_maxs, total_maxsum_size * sizeof(float), cudaMemcpyDeviceToHost);
    cudaMemcpy(h_sums, d_sums, total_maxsum_size * sizeof(float), cudaMemcpyDeviceToHost);
    CudaCheckError();

#if HARNESS_DEBUG
    std::cout << "\nOutput values (first few):" << std::endl;
    std::cout << "  attn[0:3] = " << h_attns[0] << ", " << h_attns[1] << ", " << h_attns[2] << std::endl;
    std::cout << "  maxs[0:3] = " << h_maxs[0] << ", " << h_maxs[1] << ", " << h_maxs[2] << std::endl;
    std::cout << "  sums[0:3] = " << h_sums[0] << ", " << h_sums[1] << ", " << h_sums[2] << std::endl;
#endif

    // ===== STEP 12: Check correctness =====
    bool attns_correct = true;
    bool maxs_correct = true;
    bool sums_correct = true;
    float max_attn_diff = 0.0f;
    float max_maxs_diff = 0.0f;
    float max_sums_diff = 0.0f;
    float avg_attn_diff = 0.0f;
    int attn_nan_count = 0, maxs_nan_count = 0, sums_nan_count = 0;

    for(int chunk = 0; chunk < N_CHUNKS; chunk++) {
        int offset = h_offsets[chunk];

        // Check attention outputs
        for(int i = 0; i < OUT_CHUNK_SIZE; i++) {
            int idx = offset * N_HEADS * D_HEAD + i;
            float actual = h_attns[idx];
            float expected = h_out_ref[chunk][i];
            float diff = std::abs(actual - expected);

            if (std::isnan(actual) || std::isinf(actual)) {
                attn_nan_count++;
                attns_correct = false;
            } else {
                avg_attn_diff += diff;
                max_attn_diff = std::max(max_attn_diff, diff);
                if(diff > 0.1f) {
                    attns_correct = false;
                }
            }
        }

        // Check max/sum outputs
        for(int i = 0; i < MAX_SUM_CHUNK_SIZE; i++) {
            int idx = offset * N_HEADS + i;

            float maxs_diff = std::abs(h_maxs[idx] - h_maxs_ref[chunk][i]);
            float sums_diff = std::abs(h_sums[idx] - h_sums_ref[chunk][i]);

            if (std::isnan(h_maxs[idx])) maxs_nan_count++;
            if (std::isnan(h_sums[idx])) sums_nan_count++;

            max_maxs_diff = std::max(max_maxs_diff, maxs_diff);
            max_sums_diff = std::max(max_sums_diff, sums_diff);

            if(maxs_diff > 0.1f || std::isnan(maxs_diff)) {
                maxs_correct = false;
            }
            if(sums_diff > 0.1f || std::isnan(sums_diff)) {
                sums_correct = false;
            }
        }
    }

    avg_attn_diff /= (N_CHUNKS * OUT_CHUNK_SIZE);

    std::cout << "\n=== Correctness Results ===" << std::endl;
    std::cout << "Attention outputs: " << (attns_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_attn_diff << ", Avg diff: " << avg_attn_diff << std::endl;
    if (attn_nan_count > 0) std::cout << "  NaN/Inf count: " << attn_nan_count << std::endl;

    std::cout << "Max values: " << (maxs_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_maxs_diff << std::endl;
    if (maxs_nan_count > 0) std::cout << "  NaN count: " << maxs_nan_count << std::endl;

    std::cout << "Sum values: " << (sums_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_sums_diff << std::endl;
    if (sums_nan_count > 0) std::cout << "  NaN count: " << sums_nan_count << std::endl;

    if(attns_correct && maxs_correct && sums_correct) {
        std::cout << "\n✓ All tests PASSED!" << std::endl;
    } else {
        std::cout << "\n✗ Some tests FAILED" << std::endl;

#if HARNESS_DEBUG
        // Print first few mismatches for debugging
        std::cout << "\nFirst few mismatches:" << std::endl;
        int shown = 0;
        for(int chunk = 0; chunk < N_CHUNKS && shown < 5; chunk++) {
            int offset = h_offsets[chunk];
            for(int i = 0; i < MAX_SUM_CHUNK_SIZE && shown < 5; i++) {
                int idx = offset * N_HEADS + i;
                if (std::abs(h_maxs[idx] - h_maxs_ref[chunk][i]) > 0.1f) {
                    std::cout << "  maxs[chunk=" << chunk << ", i=" << i << "]: "
                              << "got=" << h_maxs[idx] << ", expected=" << h_maxs_ref[chunk][i] << std::endl;
                    shown++;
                }
            }
        }
#endif
    }

    // ===== Cleanup =====
    delete[] h_q_float;
    for(int i = 0; i < N_CHUNKS; i++) {
        delete[] h_k_float[i];
        delete[] h_v_float[i];
        delete[] h_out_ref[i];
        delete[] h_maxs_ref[i];
        delete[] h_sums_ref[i];
    }
    delete[] h_attns;
    delete[] h_maxs;
    delete[] h_sums;

    cudaFree(d_q);
    for(int i = 0; i < N_CHUNKS; i++) {
        cudaFree(d_k[i]);
        cudaFree(d_v[i]);
    }
    cudaFree(d_attns);
    cudaFree(d_maxs);
    cudaFree(d_sums);
    cudaFree(d_keys_ptrs);
    cudaFree(d_values_ptrs);
    cudaFree(d_offsets);
    cudaFree(d_begins);
    cudaFree(d_ends);

    return attns_correct && maxs_correct && sums_correct ? 0 : 1;
}
