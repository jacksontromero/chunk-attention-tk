#include <iostream>
#include <string>
#include <fstream>
#include <vector>
#include <cmath>

// Test configuration - must match gentests.py
constexpr int N_SEQS = 16;
constexpr int CHUNK_SIZE = 64;
constexpr int D_HEAD = 128;
constexpr int N_HEADS = 4;
constexpr int N_CHUNKS = 2;
constexpr int BLOCK_SIZE = 128;

#define CudaCheckError()    __cudaCheckError( __FILE__, __LINE__ )
inline void __cudaCheckError( const char *file, const int line ) {
    cudaError err = cudaGetLastError();
    if ( cudaSuccess != err )
    {
        fprintf( stderr, "cudaCheckError() failed at %s:%i : %s\n",
                 file, line, cudaGetErrorString( err ) );
        exit( -1 );
    }
    err = cudaDeviceSynchronize();
    if( cudaSuccess != err )
    {
        fprintf( stderr, "cudaCheckError() with sync failed at %s:%i : %s\n",
                 file, line, cudaGetErrorString( err ) );
        exit( -1 );
    }
}

template<typename T>
void read_array(std::ifstream& infile, T* arr, int count, const char* name) {
    std::cout << "Loading " << name << " (" << count << " elements)..." << std::endl;
    for(int i = 0; i < count; i++) {
        float val;
        infile >> val;
        arr[i] = static_cast<T>(val);
    }
}

int main(int argc, char **argv) {
    if (argc < 2) {
        std::cerr << "Usage: " << argv[0] << " <test_file.txt>" << std::endl;
        return 1;
    }

    std::cout << "Chunked Attention Test Harness" << std::endl;
    std::cout << "Configuration: N_SEQS=" << N_SEQS << ", CHUNK_SIZE=" << CHUNK_SIZE
              << ", D_HEAD=" << D_HEAD << ", N_HEADS=" << N_HEADS << ", N_CHUNKS=" << N_CHUNKS << std::endl;

    // Allocate host memory
    constexpr int Q_SIZE = N_SEQS * N_HEADS * D_HEAD;
    constexpr int KV_CHUNK_SIZE = N_HEADS * CHUNK_SIZE * D_HEAD;
    constexpr int OUT_CHUNK_SIZE = N_HEADS * N_SEQS * D_HEAD;
    constexpr int MAX_SUM_CHUNK_SIZE = N_HEADS * N_SEQS;

    float *h_q = new float[Q_SIZE];
    float *h_k[N_CHUNKS];
    float *h_v[N_CHUNKS];
    float *h_out_ref[N_CHUNKS];
    float *h_maxs_ref[N_CHUNKS];
    float *h_sums_ref[N_CHUNKS];

    for(int i = 0; i < N_CHUNKS; i++) {
        h_k[i] = new float[KV_CHUNK_SIZE];
        h_v[i] = new float[KV_CHUNK_SIZE];
        h_out_ref[i] = new float[OUT_CHUNK_SIZE];
        h_maxs_ref[i] = new float[MAX_SUM_CHUNK_SIZE];
        h_sums_ref[i] = new float[MAX_SUM_CHUNK_SIZE];
    }

    // Load test data
    std::ifstream infile(argv[1]);
    if (!infile.is_open()) {
        std::cerr << "Failed to open " << argv[1] << std::endl;
        return 1;
    }

    read_array(infile, h_q, Q_SIZE, "Q");
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "K chunk %d", i);
        read_array(infile, h_k[i], KV_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "V chunk %d", i);
        read_array(infile, h_v[i], KV_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Output ref chunk %d", i);
        read_array(infile, h_out_ref[i], OUT_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Maxs ref chunk %d", i);
        read_array(infile, h_maxs_ref[i], MAX_SUM_CHUNK_SIZE, name);
    }
    for(int i = 0; i < N_CHUNKS; i++) {
        char name[64];
        sprintf(name, "Sums ref chunk %d", i);
        read_array(infile, h_sums_ref[i], MAX_SUM_CHUNK_SIZE, name);
    }

    std::cout << "Test data loaded successfully!" << std::endl;

    // Allocate device memory
    bf16 *d_q;
    bf16 *d_k[N_CHUNKS];
    bf16 *d_v[N_CHUNKS];
    float *d_attns;
    float *d_maxs;
    float *d_sums;
    void **d_keys_ptrs;
    void **d_values_ptrs;
    int *d_offsets, *d_begins, *d_ends;

    cudaMalloc(&d_q, Q_SIZE * sizeof(float));
    for(int i = 0; i < N_CHUNKS; i++) {
        cudaMalloc(&d_k[i], KV_CHUNK_SIZE * sizeof(float));
        cudaMalloc(&d_v[i], KV_CHUNK_SIZE * sizeof(float));
    }

    // Output buffers - accumulate all chunks
    cudaMalloc(&d_attns, N_CHUNKS * OUT_CHUNK_SIZE * sizeof(float));
    cudaMalloc(&d_maxs, N_CHUNKS * MAX_SUM_CHUNK_SIZE * sizeof(float));
    cudaMalloc(&d_sums, N_CHUNKS * MAX_SUM_CHUNK_SIZE * sizeof(float));

    // Copy input data to device
    cudaMemcpy(d_q, h_q, Q_SIZE * sizeof(float), cudaMemcpyHostToDevice);
    for(int i = 0; i < N_CHUNKS; i++) {
        cudaMemcpy(d_k[i], h_k[i], KV_CHUNK_SIZE * sizeof(float), cudaMemcpyHostToDevice);
        cudaMemcpy(d_v[i], h_v[i], KV_CHUNK_SIZE * sizeof(float), cudaMemcpyHostToDevice);
    }

    // Create pointer arrays on device
    void *h_keys_ptrs[N_CHUNKS];
    void *h_values_ptrs[N_CHUNKS];
    for(int i = 0; i < N_CHUNKS; i++) {
        h_keys_ptrs[i] = d_k[i];
        h_values_ptrs[i] = d_v[i];
    }
    cudaMalloc(&d_keys_ptrs, N_CHUNKS * sizeof(void*));
    cudaMalloc(&d_values_ptrs, N_CHUNKS * sizeof(void*));
    cudaMemcpy(d_keys_ptrs, h_keys_ptrs, N_CHUNKS * sizeof(void*), cudaMemcpyHostToDevice);
    cudaMemcpy(d_values_ptrs, h_values_ptrs, N_CHUNKS * sizeof(void*), cudaMemcpyHostToDevice);

    // Setup chunk metadata (begins, ends, offsets)
    int h_begins[N_CHUNKS];
    int h_ends[N_CHUNKS];
    int h_offsets[N_CHUNKS];

    for(int i = 0; i < N_CHUNKS; i++) {
        h_begins[i] = 0;          // All chunks process seqs [0, N_SEQS)
        h_ends[i] = N_SEQS;
        h_offsets[i] = i * N_SEQS; // Sequential offsets for output
    }

    cudaMalloc(&d_begins, N_CHUNKS * sizeof(int));
    cudaMalloc(&d_ends, N_CHUNKS * sizeof(int));
    cudaMalloc(&d_offsets, N_CHUNKS * sizeof(int));
    cudaMemcpy(d_begins, h_begins, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);
    cudaMemcpy(d_ends, h_ends, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);
    cudaMemcpy(d_offsets, h_offsets, N_CHUNKS * sizeof(int), cudaMemcpyHostToDevice);

    // Setup globals for kernel
    using globals_t = attn_chunk_first_globals<N_SEQS, D_HEAD>;

    // Construct gl objects first
    auto gQ = gl<bf16, 1, N_SEQS, -1, D_HEAD, st<bf16, N_SEQS, D_HEAD>>(
        d_q, nullptr, nullptr, N_HEADS, nullptr);

    auto gAttns = gl<float, -1, -1, -1, -1>(
        d_attns, 1, 1, N_CHUNKS * N_HEADS * N_SEQS, D_HEAD);

    auto gMaxs = gl<float, -1, -1, -1, -1>(
        d_maxs, 1, 1, 1, N_CHUNKS * MAX_SUM_CHUNK_SIZE);

    auto gSums = gl<float, -1, -1, -1, -1>(
        d_sums, 1, 1, 1, N_CHUNKS * MAX_SUM_CHUNK_SIZE);

    auto gOffsets = gl<int, -1, -1, -1, -1>(
        d_offsets, 1, 1, 1, N_CHUNKS);

    auto gBegins = gl<int, -1, -1, -1, -1>(
        d_begins, 1, 1, 1, N_CHUNKS);

    auto gEnds = gl<int, -1, -1, -1, -1>(
        d_ends, 1, 1, 1, N_CHUNKS);

    // Now construct globals with aggregate initialization
    globals_t g{
        .gAttns = gAttns,
        .gMaxs = gMaxs,
        .gSums = gSums,
        .gOffsets = gOffsets,
        .gBegins = gBegins,
        .gEnds = gEnds,
        .gQ_1_S_H_D = gQ,
        .gKeys = d_keys_ptrs,
        .gValues = d_values_ptrs,
        .dim_scale = 1.0f / sqrtf(static_cast<float>(D_HEAD)),
        .n_heads = N_HEADS
    };

    // Calculate shared memory size (TODO COME BACK TO THIS)
    size_t shared_mem_size = sizeof(st<bf16, N_SEQS, D_HEAD>) * 3 +  // Qs, Ks, Vs, output
                             sizeof(st<bf16, N_SEQS, CHUNK_SIZE>);     // additional output tile
    std::cout << "Shared memory size: " << shared_mem_size << " bytes" << std::endl;

    // Set kernel attributes
    cudaFuncSetAttribute(
        attn_chunk_first_tk<N_SEQS, CHUNK_SIZE, D_HEAD>,
        cudaFuncAttributeMaxDynamicSharedMemorySize,
        shared_mem_size
    );

    // Launch kernel
    dim3 grid(N_HEADS, N_CHUNKS);
    dim3 block(BLOCK_SIZE);

    std::cout << "Launching kernel with grid(" << grid.x << ", " << grid.y << "), block(" << block.x << ")" << std::endl;

    cudaDeviceSynchronize();
    const auto start = std::chrono::high_resolution_clock::now();

    attn_chunk_first_tk<N_SEQS, CHUNK_SIZE, D_HEAD><<<grid, block, shared_mem_size>>>(g);

    cudaDeviceSynchronize();
    const auto finish = std::chrono::high_resolution_clock::now();
    CudaCheckError();

    std::cout << "Kernel completed successfully!" << std::endl;
    std::cout << "Execution time: " << std::chrono::duration_cast<std::chrono::microseconds>(finish - start).count()
              << " us" << std::endl;

    // Copy results back
    float *h_attns = new float[N_CHUNKS * OUT_CHUNK_SIZE];
    float *h_maxs = new float[N_CHUNKS * MAX_SUM_CHUNK_SIZE];
    float *h_sums = new float[N_CHUNKS * MAX_SUM_CHUNK_SIZE];

    cudaMemcpy(h_attns, d_attns, N_CHUNKS * OUT_CHUNK_SIZE * sizeof(float), cudaMemcpyDeviceToHost);
    cudaMemcpy(h_maxs, d_maxs, N_CHUNKS * MAX_SUM_CHUNK_SIZE * sizeof(float), cudaMemcpyDeviceToHost);
    cudaMemcpy(h_sums, d_sums, N_CHUNKS * MAX_SUM_CHUNK_SIZE * sizeof(float), cudaMemcpyDeviceToHost);

    // Check correctness
    bool attns_correct = true;
    bool maxs_correct = true;
    bool sums_correct = true;
    float max_attn_diff = 0.0f;
    float max_maxs_diff = 0.0f;
    float max_sums_diff = 0.0f;
    float avg_attn_diff = 0.0f;

    for(int chunk = 0; chunk < N_CHUNKS; chunk++) {
        int offset = h_offsets[chunk];
        for(int i = 0; i < OUT_CHUNK_SIZE; i++) {
            int idx = offset * N_HEADS * D_HEAD + i;
            float diff = std::abs(h_attns[idx] - h_out_ref[chunk][i]);
            avg_attn_diff += diff;
            max_attn_diff = std::max(max_attn_diff, diff);
            if(diff > 0.1f || std::isnan(diff)) {
                attns_correct = false;
            }
        }

        for(int i = 0; i < MAX_SUM_CHUNK_SIZE; i++) {
            int idx = offset * N_HEADS + i;
            float diff = std::abs(h_maxs[idx] - h_maxs_ref[chunk][i]);
            max_maxs_diff = std::max(max_maxs_diff, diff);
            if(diff > 0.1f || std::isnan(diff)) {
                maxs_correct = false;
            }

            diff = std::abs(h_sums[idx] - h_sums_ref[chunk][i]);
            max_sums_diff = std::max(max_sums_diff, diff);
            if(diff > 0.1f || std::isnan(diff)) {
                sums_correct = false;
            }
        }
    }

    avg_attn_diff /= (N_CHUNKS * OUT_CHUNK_SIZE);

    std::cout << "\n=== Correctness Results ===" << std::endl;
    std::cout << "Attention outputs: " << (attns_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_attn_diff << ", Avg diff: " << avg_attn_diff << std::endl;
    std::cout << "Max values: " << (maxs_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_maxs_diff << std::endl;
    std::cout << "Sum values: " << (sums_correct ? "PASS ✓" : "FAIL ✗") << std::endl;
    std::cout << "  Max diff: " << max_sums_diff << std::endl;

    if(attns_correct && maxs_correct && sums_correct) {
        std::cout << "\n✓ All tests PASSED!" << std::endl;
    } else {
        std::cout << "\n✗ Some tests FAILED" << std::endl;
    }

    // Cleanup
    delete[] h_q;
    for(int i = 0; i < N_CHUNKS; i++) {
        delete[] h_k[i];
        delete[] h_v[i];
        delete[] h_out_ref[i];
        delete[] h_maxs_ref[i];
        delete[] h_sums_ref[i];
    }
    delete[] h_attns;
    delete[] h_maxs;
    delete[] h_sums;

    cudaFree(d_q);
    for(int i = 0; i < N_CHUNKS; i++) {
        cudaFree(d_k[i]);
        cudaFree(d_v[i]);
    }
    cudaFree(d_attns);
    cudaFree(d_maxs);
    cudaFree(d_sums);
    cudaFree(d_keys_ptrs);
    cudaFree(d_values_ptrs);
    cudaFree(d_offsets);
    cudaFree(d_begins);
    cudaFree(d_ends);

    return attns_correct && maxs_correct && sums_correct ? 0 : 1;
}

